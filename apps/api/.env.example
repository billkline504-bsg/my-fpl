# Copy to .env after running `supabase start` from the repo root and reading
# its output (or `supabase status` if it's already running).

PORT=4000

# The local Postgres connection string from `supabase status` (DB URL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used both to verify access tokens (via its JWKS endpoint) and, if the API
# ever needs to call Supabase's REST/Auth admin endpoints.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# API key from the Resend dashboard (Settings -> API Keys). Used to send
# gameweek deadline reminder emails.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "My FPL <reminders@yourdomain.com>".
REMINDER_FROM_EMAIL=My FPL <reminders@my-fpl.app>
# How long before a gameweek's deadline each reminder email goes out.
REMINDER_DAYS_BEFORE=1
REMINDER_HOURS_BEFORE=2
# Used to build the link back to the app in reminder emails.
APP_BASE_URL=http://localhost:5173
