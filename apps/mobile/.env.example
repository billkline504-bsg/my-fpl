# Copy to .env after running `supabase status` from the repo root.
# The device/simulator running Expo must be able to reach this host — an
# emulator can usually use 127.0.0.1, but a physical phone on the same
# Wi-Fi needs your machine's LAN IP instead (e.g. http://192.168.1.23:54321).

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
